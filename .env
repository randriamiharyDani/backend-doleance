# Serveur
PORT=5000

# PRODUIRE : passer a "production" sur le serveur de production.
# En "production" le rate-limiting est actif et le CORS devient strict
# (voir CORS_ORIGINS plus bas).
NODE_ENV=development

# URL publique du frontend, utilisee pour les liens dans les e-mails
# (reinitialisation de mot de passe, suivi de doléance, transfert).
# A RENSEIGNER en production, sinon les liens des e-mails pointent
# sur localhost:5173.
FRONTEND_URL=http://localhost:5173

# HTTPS (désactivé — retour à HTTP)
# HTTPS_KEY_PATH=./192.168.99.4+2-key.pem
# HTTPS_CERT_PATH=./192.168.99.4+2.pem

# CORS (origines separees par des virgules, TOUT SUR UNE SEULE LIGNE)
# ATTENTION : une valeur repartie sur plusieurs lignes est tronquee par
# dotenv a la fin de la 1re ligne (les suivantes sont ignorees sans erreur).
# >> Ajouter ici l'URL publique du site si le frontend/appel Socket.IO
# >> ne passe PAS par le reverse-proxy Apache.
CORS_ORIGINS=http://localhost:5173,http://192.168.99.4:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Base de données - Local (XAMPP)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_doleances
DB_PORT=3306

# Base de données - Distant (Serveur 4 / production) — conservé mais inactif
# DB_HOST=192.168.99.4
# DB_USER=dev
# DB_PASSWORD=S3cur1tydev@ddnsi
# DB_NAME=gestion_doleances
# DB_PORT=3304

# JWT
JWT_SECRET=super_secret_key_2024_pour_jwt_au_moins_32_caracteres
JWT_EXPIRE=24h

# Email
# Gmail: Activer la validation en 2 étapes, puis créer un "Mot de passe d'application"
# https://myaccount.google.com/apppasswords → Sélectionnez "Autre (nom personnalisé)" → Copiez le mot de passe
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=randriamiharysteev@gmail.com
SMTP_PASS=vndw euti qnvi ffar
SMTP_FROM=randriamiharysteev@gmail.com

# Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100