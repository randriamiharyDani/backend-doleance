# Serveur
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de données - Utilisation de root
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_doleances
DB_PORT=3306

# JWT
JWT_SECRET=super_secret_key_2024_pour_jwt_au_moins_32_caracteres
JWT_EXPIRE=24h

# Email (optionnel - désactivé pour le moment)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
